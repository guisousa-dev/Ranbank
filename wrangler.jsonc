{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "www",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/app-router-entry",
  "assets": {
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  // Domínio próprio. O endereço antigo (*.workers.dev) continua funcionando,
  // para os links que já foram compartilhados não quebrarem.
  "workers_dev": true,
  "routes": [
    { "pattern": "ranbank.com.br", "custom_domain": true },
    { "pattern": "www.ranbank.com.br", "custom_domain": true }
  ]
}
